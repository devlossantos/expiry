# Secrets and environment for the expiry container (docker run --env-file /etc/expiry/expiry.env).
# Keep this file private: chmod 600, owned by root.

# Container timezone (config.yaml `timezone` is what expiry uses for days left and the schedule)
TZ=Europe/Dublin

# Entra ID app registration (see README "Connect to Entra ID")
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# or, with certificate authentication instead of a secret (entra.certificate_path in config.yaml):
# ENTRA_CERT_THUMBPRINT=

# SMTP (email.transport: smtp)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional chat webhooks referenced from config.yaml
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
